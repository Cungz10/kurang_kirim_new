<%- include('../layouts/header', { title: 'Edit Toko' }) %>

<div class="max-w-xl mx-auto">
    <!-- Header -->
    <div class="flex items-center gap-4 mb-6">
        <a href="/toko" class="flex h-9 w-9 items-center justify-center rounded-full ios-btn-secondary text-white/70 hover:text-white transition-all">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Edit Toko</h1>
            <p class="text-xs text-white/50"><%= toko.kode_toko %> — <%= toko.nama_toko %></p>
        </div>
    </div>

    <!-- Form Glass Card -->
    <div class="ios-glass-card rounded-[32px] relative overflow-hidden shadow-2xl">
        <div class="absolute inset-x-0 top-0 h-[1.5px] bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></div>

        <div class="p-6 sm:p-9">
            <form action="/toko/<%= toko.id %>?_method=PUT" method="POST" class="space-y-5">
                <input type="hidden" name="_method" value="PUT">

                <div>
                    <label for="kode_toko" class="block text-sm font-medium text-white/80 mb-2">
                        Kode Toko <span class="text-rose-400">*</span>
                    </label>
                    <input type="text" id="kode_toko" name="kode_toko" value="<%= toko.kode_toko %>" required maxlength="50"
                           class="w-full ios-input px-4 py-3 text-sm text-white font-mono uppercase">
                </div>

                <div>
                    <label for="nama_toko" class="block text-sm font-medium text-white/80 mb-2">
                        Nama Toko <span class="text-rose-400">*</span>
                    </label>
                    <input type="text" id="nama_toko" name="nama_toko" value="<%= toko.nama_toko %>" required maxlength="255"
                           class="w-full ios-input px-4 py-3 text-sm text-white">
                </div>

                <!-- Info Badges -->
                <div class="pt-3 border-t border-white/10 text-xs text-white/50 flex items-center justify-between">
                    <span>
                        Dibuat: <strong class="text-white/80 font-mono"><%= formatDate(toko.created_at) %></strong>
                    </span>
                    <span>
                        Status:
                        <% if (toko.status) { %>
                            <span class="text-emerald-400 font-medium">Aktif</span>
                        <% } else { %>
                            <span class="text-white/40 font-medium">Nonaktif</span>
                        <% } %>
                    </span>
                </div>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-6 border-t border-white/10">
                    <button type="submit"
                            class="flex-1 ios-btn-primary rounded-2xl py-3.5 px-6 font-semibold flex items-center justify-center gap-2 text-white">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"/></svg>
                        Simpan Perubahan
                    </button>
                    <a href="/toko"
                       class="sm:w-auto ios-btn-secondary rounded-2xl py-3.5 px-6 font-medium text-white/80 hover:text-white text-center">
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
