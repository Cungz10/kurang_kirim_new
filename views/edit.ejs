<%- include('layouts/header', { title: 'Edit Surat Jalan' }) %>

<div class="max-w-2xl mx-auto">
    <!-- Navigation Back Link -->
    <div class="mb-6">
        <a href="/history" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full ios-btn-secondary text-xs font-medium text-white/80 hover:text-white mb-3">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
            Kembali ke Riwayat
        </a>
        <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Edit Surat Jalan</h1>
        <p class="mt-1 text-sm text-white/60">Perbarui data <span class="text-blue-400 font-mono font-medium"><%= item.nomor_surat_jalan %></span></p>
    </div>

    <!-- iOS Glass Card -->
    <div class="ios-glass-card rounded-[32px] relative overflow-hidden shadow-2xl">
        <div class="absolute inset-x-0 top-0 h-[1.5px] bg-gradient-to-r from-transparent via-white/50 to-transparent pointer-events-none"></div>

        <div class="p-6 sm:p-9">
            <form action="/kurang-kirim/<%= item.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" name="_method" value="PUT">
                
                <!-- Kode Toko -->
                <div>
                    <label for="toko_id" class="block text-sm font-medium text-white/80 mb-2">
                        Pilih Toko <span class="text-rose-400">*</span>
                    </label>
                    <div class="relative">
                        <select id="toko_id" name="toko_id" required class="w-full ios-input cursor-pointer">
                            <option value="">— Cari & Pilih Toko —</option>
                            <% tokoList.forEach(function(toko) { %>
                                <option value="<%= toko.id %>" <%= item.toko_id == toko.id ? 'selected' : '' %>>
                                    <%= toko.kode_toko %> — <%= toko.nama_toko %>
                                </option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <!-- Tanggal Kirim -->
                <div>
                    <label for="tgl_kirim" class="block text-sm font-medium text-white/80 mb-2">
                        Tanggal Kirim <span class="text-rose-400">*</span>
                    </label>
                    <input type="date" id="tgl_kirim" name="tgl_kirim" value="<%= item.tgl_kirim %>" required
                           class="w-full ios-input px-4 py-3 text-sm text-white [color-scheme:dark]">
                </div>

                <!-- Nomor Surat Jalan -->
                <div>
                    <label for="nomor_surat_jalan" class="block text-sm font-medium text-white/80 mb-2">
                        Nomor Surat Jalan <span class="text-rose-400">*</span>
                    </label>
                    <input type="text" id="nomor_surat_jalan" name="nomor_surat_jalan" value="<%= item.nomor_surat_jalan %>" required
                           class="w-full ios-input px-4 py-3 text-sm text-white font-mono">
                </div>

                <!-- Lampiran -->
                <div>
                    <label class="block text-sm font-medium text-white/80 mb-2">
                        Lampiran File <span class="text-white/40 text-xs font-normal">(kosongkan jika tidak ingin mengubah file)</span>
                    </label>
                    <% if (item.lampiran) { %>
                        <div class="rounded-[20px] ios-glass-card-subtle p-3.5 px-4 mb-3 flex items-center justify-between">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[12px] bg-blue-500/20 text-blue-400 border border-blue-500/30">
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs text-white/40">File Dokumen Saat Ini</p>
                                    <p class="text-sm font-medium text-white truncate"><%= item.original_filename || item.lampiran %></p>
                                </div>
                            </div>
                            <a href="/kurang-kirim/<%= item.id %>/view" target="_blank"
                               class="text-xs font-semibold px-3 py-1.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 hover:bg-cyan-500/30 transition-colors">
                                Pratinjau
                            </a>
                        </div>
                    <% } %>
                    <input type="file" name="lampiran" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
                           class="w-full ios-input px-4 py-2.5 text-xs text-white file:mr-4 file:rounded-xl file:border-0 file:bg-blue-500/20 file:text-blue-300 file:border file:border-blue-500/30 file:px-3 file:py-1.5 file:text-xs file:font-semibold hover:file:bg-blue-500/30 transition-all">
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-6 border-t border-white/10">
                    <button type="submit" class="flex-1 ios-btn-primary rounded-2xl py-3.5 px-6 font-semibold flex items-center justify-center gap-2 text-white">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M5 13l4 4L19 7"/></svg>
                        Perbarui Surat Jalan
                    </button>
                    <a href="/history" class="sm:w-auto ios-btn-secondary rounded-2xl py-3.5 px-6 font-medium text-white/80 hover:text-white text-center">
                        Batal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    if (document.getElementById('toko_id')) {
        new TomSelect('#toko_id', {
            create: false,
            placeholder: '— Cari & Pilih Toko —',
            maxOptions: 50,
        });
    }
});
</script>

<%- include('layouts/footer') %>
